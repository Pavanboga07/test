# ============================================================================
# AI Nexus Gateway (Application B) — Environment Configuration
# Copy to .env for local development or configure in Render Environment tab
# ============================================================================

NODE_ENV=production
PORT=4000
GATEWAY_HOST=0.0.0.0

# Public Gateway URLs (Configure with your Render service URL in production)
GATEWAY_PUBLIC_URL=https://<render-service>.onrender.com
GATEWAY_WS_URL=wss://<render-service>.onrender.com/ws/node
NODE_WS_PATH=/ws/node

# Durable Gateway SQLite Storage (Mounted Render Persistent Disk at /var/data)
GATEWAY_DATA_DIR=/var/data
GATEWAY_DB_PATH=/var/data/gateway.sqlite

# Security & Rate Limiting
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
GATEWAY_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
